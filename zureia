
-- ORELHA HUB
-- ESP + FOV seguindo o mouse + seleção visual de alvo
-- Para seu próprio jogo no Roblox Studio

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local espEnabled = false
local aimEnabled = false
local fov = 150

local highlights = {}
local connections = {}
local currentTarget = nil
local closed = false

-- GUI
local gui = Instance.new("ScreenGui")
gui.Name = "ORELHA_HUB"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.Parent = playerGui

local panel = Instance.new("Frame")
panel.Size = UDim2.fromOffset(250, 245)
panel.Position = UDim2.new(0, 30, 0.35, 0)
panel.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
panel.BorderSizePixel = 0
panel.Parent = gui

local panelCorner = Instance.new("UICorner")
panelCorner.CornerRadius = UDim.new(0, 10)
panelCorner.Parent = panel

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 40)
title.BackgroundColor3 = Color3.fromRGB(110, 35, 180)
title.Text = "ORELHA HUB"
title.TextColor3 = Color3.new(1, 1, 1)
title.Font = Enum.Font.GothamBold
title.TextSize = 19
title.Parent = panel

local function createButton(text, y)
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(1, -20, 0, 38)
    button.Position = UDim2.fromOffset(10, y)
    button.BackgroundColor3 = Color3.fromRGB(65, 45, 90)
    button.TextColor3 = Color3.new(1, 1, 1)
    button.Font = Enum.Font.GothamBold
    button.TextSize = 14
    button.Text = text
    button.Parent = panel

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 7)
    corner.Parent = button

    return button
end

local espButton = createButton("ESP: OFF", 50)
local aimButton = createButton("AIM ASSIST: OFF", 95)
local fovButton = createButton("FOV: 150", 140)
local closeButton = createButton("FECHAR HUB", 185)

-- Círculo FOV
local circle = Instance.new("Frame")
circle.Name = "FOVCircle"
circle.AnchorPoint = Vector2.new(0.5, 0.5)
circle.Size = UDim2.fromOffset(fov * 2, fov * 2)
circle.BackgroundTransparency = 1
circle.Visible = false
circle.Parent = gui

local circleCorner = Instance.new("UICorner")
circleCorner.CornerRadius = UDim.new(1, 0)
circleCorner.Parent = circle

local stroke = Instance.new("UIStroke")
stroke.Color = Color3.fromRGB(180, 80, 255)
stroke.Thickness = 2
stroke.Parent = circle

-- Status do alvo
local status = Instance.new("TextLabel")
status.Size = UDim2.new(1, -20, 0, 20)
status.Position = UDim2.fromOffset(10, 225)
status.BackgroundTransparency = 1
status.Text = "Alvo: nenhum"
status.TextColor3 = Color3.new(1, 1, 1)
status.Font = Enum.Font.Gotham
status.TextSize = 12
status.Parent = panel

-- ESP de jogadores
local function removeESP(target)
    if highlights[target] then
        highlights[target]:Destroy()
        highlights[target] = nil
    end
end

local function addESP(target)
    if target == player or not espEnabled then
        return
    end

    local character = target.Character
    if not character then return end

    removeESP(target)

    local highlight = Instance.new("Highlight")
    highlight.Name = "OrelhaPlayerESP"
    highlight.Adornee = character
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.FillColor = Color3.fromRGB(150, 50, 255)
    highlight.OutlineColor = Color3.new(1, 1, 1)
    highlight.FillTransparency = 0.55
    highlight.OutlineTransparency = 0
    highlight.Parent = gui

    highlights[target] = highlight
end

local function refreshESP()
    for _, target in ipairs(Players:GetPlayers()) do
        if target ~= player then
            if espEnabled then
                addESP(target)
            else
                removeESP(target)
            end
        end
    end
end

-- Seleção visual do alvo mais próximo do cursor
local function getAimTarget()
    if not aimEnabled then
        return nil
    end

    local camera = Workspace.CurrentCamera
    if not camera then return nil end

    local mousePosition = UserInputService:GetMouseLocation()
    local bestTarget = nil
    local bestDistance = fov

    for _, target in ipairs(Players:GetPlayers()) do
        if target ~= player then
            local character = target.Character
            local humanoid = character
                and character:FindFirstChildOfClass("Humanoid")
            local head = character and character:FindFirstChild("Head")

            if humanoid and humanoid.Health > 0 and head then
                local screenPosition, visible =
                    camera:WorldToViewportPoint(head.Position)

                if visible then
                    local distance = (
                        Vector2.new(screenPosition.X, screenPosition.Y)
                        - mousePosition
                    ).Magnitude

                    if distance < bestDistance then
                        bestDistance = distance
                        bestTarget = target
                    end
                end
            end
        end
    end

    return bestTarget
end

-- Botão ESP
espButton.MouseButton1Click:Connect(function()
    espEnabled = not espEnabled
    espButton.Text = espEnabled and "ESP: ON" or "ESP: OFF"
    refreshESP()
end)

-- Botão Aim Assist
aimButton.MouseButton1Click:Connect(function()
    aimEnabled = not aimEnabled
    aimButton.Text = aimEnabled
        and "AIM ASSIST: ON"
        or "AIM ASSIST: OFF"

    circle.Visible = aimEnabled
    currentTarget = nil
end)

-- Ajustar FOV
fovButton.MouseButton1Click:Connect(function()
    fov = fov + 25

    if fov > 400 then
        fov = 50
    end

    circle.Size = UDim2.fromOffset(fov * 2, fov * 2)
    fovButton.Text = "FOV: " .. fov
end)

-- Atualização do mouse e seleção visual
local renderConnection = RunService.RenderStepped:Connect(function()
    if closed then return end

    local mousePosition = UserInputService:GetMouseLocation()

    -- O círculo acompanha o cursor
    circle.Position = UDim2.fromOffset(
        mousePosition.X,
        mousePosition.Y
    )

    currentTarget = getAimTarget()

    if currentTarget then
        status.Text = "Alvo: " .. currentTarget.Name
    else
        status.Text = "Alvo: nenhum"
    end
end)

-- Jogadores que entram e renascem
local function setupPlayer(target)
    if target == player then return end

    if connections[target] then
        connections[target]:Disconnect()
    end

    connections[target] = target.CharacterAdded:Connect(function()
        task.wait(0.5)

        if espEnabled then
            addESP(target)
        end
    end)

    if espEnabled then
        addESP(target)
    end
end

for _, target in ipairs(Players:GetPlayers()) do
    setupPlayer(target)
end

Players.PlayerAdded:Connect(setupPlayer)

Players.PlayerRemoving:Connect(function(target)
    removeESP(target)

    if connections[target] then
        connections[target]:Disconnect()
        connections[target] = nil
    end

    if currentTarget == target then
        currentTarget = nil
    end
end)

-- Arrastar painel
local dragging = false
local dragStart
local startPosition

title.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPosition = panel.Position
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position - dragStart

        panel.Position = UDim2.new(
            startPosition.X.Scale,
            startPosition.X.Offset + delta.X,
            startPosition.Y.Scale,
            startPosition.Y.Offset + delta.Y
        )
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false
    end
end)

-- Fechar e limpar
closeButton.MouseButton1Click:Connect(function()
    closed = true
    renderConnection:Disconnect()

    for target, connection in pairs(connections) do
        connection:Disconnect()
        connections[target] = nil
    end

    for target in pairs(highlights) do
        removeESP(target)
    end

    gui:Destroy()
end)
