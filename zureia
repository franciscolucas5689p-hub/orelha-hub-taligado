
-- ORELHA HUB
-- ESP + seleção de alvo para Aim Assist
-- Para seu próprio jogo no Roblox Studio

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer
local gui = Instance.new("ScreenGui")
gui.Name = "ORELHA_HUB"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local espEnabled = false
local aimEnabled = false
local fov = 150
local highlights = {}

-- Painel
local panel = Instance.new("Frame")
panel.Size = UDim2.fromOffset(250, 220)
panel.Position = UDim2.new(0, 30, 0.35, 0)
panel.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
panel.Parent = gui

local function button(text, y)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, -20, 0, 38)
    b.Position = UDim2.fromOffset(10, y)
    b.BackgroundColor3 = Color3.fromRGB(65, 45, 90)
    b.TextColor3 = Color3.new(1, 1, 1)
    b.Font = Enum.Font.GothamBold
    b.TextSize = 14
    b.Text = text
    b.Parent = panel
    return b
end

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 40)
title.BackgroundColor3 = Color3.fromRGB(110, 35, 180)
title.Text = "ORELHA HUB"
title.TextColor3 = Color3.new(1, 1, 1)
title.Font = Enum.Font.GothamBold
title.TextSize = 19
title.Parent = panel

local espButton = button("ESP: OFF", 50)
local aimButton = button("AIM ASSIST: OFF", 95)
local fovButton = button("FOV: 150", 140)
local closeButton = button("FECHAR", 185)

-- Círculo FOV
local circle = Instance.new("Frame")
circle.AnchorPoint = Vector2.new(0.5, 0.5)
circle.Position = UDim2.fromScale(0.5, 0.5)
circle.Size = UDim2.fromOffset(fov * 2, fov * 2)
circle.BackgroundTransparency = 1
circle.Visible = false
circle.Parent = gui

local round = Instance.new("UICorner")
round.CornerRadius = UDim.new(1, 0)
round.Parent = circle

local outline = Instance.new("UIStroke")
outline.Color = Color3.fromRGB(180, 80, 255)
outline.Thickness = 2
outline.Parent = circle

-- ESP de jogadores
local function removeESP(target)
    if highlights[target] then
        highlights[target]:Destroy()
        highlights[target] = nil
    end
end

local function addESP(target)
    if target == player or not espEnabled then return end
    local character = target.Character
    if not character then return end

    removeESP(target)

    local h = Instance.new("Highlight")
    h.Name = "OrelhaESP"
    h.Adornee = character
    h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    h.FillColor = Color3.fromRGB(150, 50, 255)
    h.OutlineColor = Color3.new(1, 1, 1)
    h.FillTransparency = 0.55
    h.Parent = gui

    highlights[target] = h
end

local function refreshESP()
    for _, target in ipairs(Players:GetPlayers()) do
        if target ~= player then
            if espEnabled then
                addESP(target)
            else
                removeESP(target)
            end
        end
    end
end

espButton.MouseButton1Click:Connect(function()
    espEnabled = not espEnabled
    espButton.Text = espEnabled and "ESP: ON" or "ESP: OFF"
    refreshESP()
end)

aimButton.MouseButton1Click:Connect(function()
    aimEnabled = not aimEnabled
    aimButton.Text = aimEnabled and "AIM ASSIST: ON" or "AIM ASSIST: OFF"
    circle.Visible = aimEnabled
end)

fovButton.MouseButton1Click:Connect(function()
    fov = fov + 25
    if fov > 400 then fov = 50 end
    circle.Size = UDim2.fromOffset(fov * 2, fov * 2)
    fovButton.Text = "FOV: " .. fov
end)

-- Seleciona o alvo mais próximo do centro da tela.
-- O sistema de armas deve validar o disparo no servidor.
local function getAimTarget()
    if not aimEnabled then return nil end

    local camera = Workspace.CurrentCamera
    if not camera then return nil end

    local center = camera.ViewportSize / 2
    local bestTarget = nil
    local bestDistance = fov

    for _, target in ipairs(Players:GetPlayers()) do
        if target ~= player then
            local character = target.Character
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")
            local head = character and character:FindFirstChild("Head")

            if humanoid and humanoid.Health > 0 and head then
                local pos, visible = camera:WorldToViewportPoint(head.Position)
                if visible then
                    local screenDistance =
                        (Vector2.new(pos.X, pos.Y) - center).Magnitude

                    if screenDistance < bestDistance then
                        local params = RaycastParams.new()
                        params.FilterType = Enum.RaycastFilterType.Exclude
                        params.FilterDescendantsInstances = {player.Character}

                        local origin = camera.CFrame.Position
                        local direction = head.Position - origin
                        local result = Workspace:Raycast(
                            origin,
                            direction,
                            params
                        )

                        if result and result.Instance:IsDescendantOf(character) then
                            bestDistance = screenDistance
                            bestTarget = head
                        end
                    end
                end
            end
        end
    end

    return bestTarget
end

-- Disponibiliza a seleção para integração com o sistema de armas.
_G.OrelhaGetAimTarget = getAimTarget

local function setupPlayer(target)
    if target == player then return end

    target.CharacterAdded:Connect(function()
        task.wait(0.5)
        if espEnabled then addESP(target) end
    end)

    if espEnabled then addESP(target) end
end

for _, target in ipairs(Players:GetPlayers()) do
    setupPlayer(target)
end

Players.PlayerAdded:Connect(setupPlayer)

Players.PlayerRemoving:Connect(function(target)
    removeESP(target)
end)

closeButton.MouseButton1Click:Connect(function()
    for target in pairs(highlights) do
        removeESP(target)
    end
    gui:Destroy()
end)
