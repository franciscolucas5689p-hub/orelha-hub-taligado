
-- ORELHA HUB
-- Ferramenta de administração/depuração do seu próprio jogo
-- Coloque em StarterPlayerScripts como LocalScript

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local espEnabled = false
local fov = 150

-- GUI principal
local gui = Instance.new("ScreenGui")
gui.Name = "ORELHA_HUB"
gui.ResetOnSpawn = false
gui.Parent = playerGui

local panel = Instance.new("Frame")
panel.Size = UDim2.fromOffset(250, 220)
panel.Position = UDim2.new(0, 30, 0.35, 0)
panel.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
panel.BorderSizePixel = 0
panel.Parent = gui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 10)
corner.Parent = panel

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 40)
title.BackgroundColor3 = Color3.fromRGB(110, 35, 180)
title.Text = "ORELHA HUB"
title.TextColor3 = Color3.new(1, 1, 1)
title.Font = Enum.Font.GothamBold
title.TextSize = 19
title.Parent = panel

local function makeButton(text, y)
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(1, -20, 0, 38)
    button.Position = UDim2.fromOffset(10, y)
    button.BackgroundColor3 = Color3.fromRGB(55, 55, 65)
    button.TextColor3 = Color3.new(1, 1, 1)
    button.Font = Enum.Font.GothamBold
    button.TextSize = 14
    button.Text = text
    button.Parent = panel

    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 7)
    c.Parent = button

    return button
end

local espButton = makeButton("ESP JOGADORES: OFF", 55)
local fovButton = makeButton("FOV: 150  (+/-)", 100)
local closeButton = makeButton("FECHAR HUB", 145)

-- Círculo do FOV
local circle = Instance.new("Frame")
circle.Name = "FOVCircle"
circle.AnchorPoint = Vector2.new(0.5, 0.5)
circle.Position = UDim2.fromScale(0.5, 0.5)
circle.Size = UDim2.fromOffset(fov * 2, fov * 2)
circle.BackgroundTransparency = 1
circle.Visible = false
circle.Parent = gui

local circleCorner = Instance.new("UICorner")
circleCorner.CornerRadius = UDim.new(1, 0)
circleCorner.Parent = circle

local stroke = Instance.new("UIStroke")
stroke.Color = Color3.fromRGB(180, 80, 255)
stroke.Thickness = 2
stroke.Parent = circle

local function updateFOV()
    circle.Size = UDim2.fromOffset(fov * 2, fov * 2)
    fovButton.Text = "FOV: " .. fov .. "  (+/-)"
end

-- ESP de jogadores
local highlights = {}

local function removeESP(target)
    if highlights[target] then
        highlights[target]:Destroy()
        highlights[target] = nil
    end
end

local function addESP(target)
    if target == player or not espEnabled then
        return
    end

    local character = target.Character
    if not character then return end

    removeESP(target)

    local highlight = Instance.new("Highlight")
    highlight.Name = "OrelhaPlayerESP"
    highlight.Adornee = character
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.FillColor = Color3.fromRGB(150, 50, 255)
    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    highlight.FillTransparency = 0.55
    highlight.OutlineTransparency = 0
    highlight.Parent = gui

    highlights[target] = highlight
end

local function refreshESP()
    for _, target in ipairs(Players:GetPlayers()) do
        if target ~= player then
            if espEnabled then
                addESP(target)
            else
                removeESP(target)
            end
        end
    end
end

espButton.MouseButton1Click:Connect(function()
    espEnabled = not espEnabled
    espButton.Text = espEnabled and "ESP JOGADORES: ON" or "ESP JOGADORES: OFF"
    circle.Visible = espEnabled
    refreshESP()
end)

fovButton.MouseButton1Click:Connect(function()
    fov = fov + 25
    if fov > 400 then
        fov = 50
    end
    updateFOV()
end)

closeButton.MouseButton1Click:Connect(function()
    gui:Destroy()
end)

-- Atualiza quando jogadores entram ou renascem
local connections = {}

local function setupPlayer(target)
    if target == player then return end

    connections[target] = target.CharacterAdded:Connect(function()
        task.wait(0.5)
        if espEnabled then
            addESP(target)
        end
    end)

    if espEnabled then
        addESP(target)
    end
end

for _, target in ipairs(Players:GetPlayers()) do
    setupPlayer(target)
end

Players.PlayerAdded:Connect(setupPlayer)

Players.PlayerRemoving:Connect(function(target)
    removeESP(target)

    if connections[target] then
        connections[target]:Disconnect()
        connections[target] = nil
    end
end)

-- Arrastar o painel
local dragging = false
local dragStart
local startPosition

title.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPosition = panel.Position
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position - dragStart
        panel.Position = UDim2.new(
            startPosition.X.Scale,
            startPosition.X.Offset + delta.X,
            startPosition.Y.Scale,
            startPosition.Y.Offset + delta.Y
        )
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false
    end
end)

updateFOV()
